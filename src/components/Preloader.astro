---
---

<div
	id="preloader-overlay"
	class="fixed inset-0 z-50 bg-[#020308] flex flex-col items-center justify-between py-12 px-6 select-none overflow-hidden"
	aria-live="polite"
	aria-label="Loading site content"
>
	<!-- Zero-Flash Inline Gating Script -->
	<script is:inline>
		try {
			if (
				sessionStorage.getItem('intro-seen') === '1' ||
				window.matchMedia('(prefers-reduced-motion: reduce)').matches
			) {
				const preloader = document.getElementById('preloader-overlay');
				if (preloader) {
					preloader.style.display = 'none';
				}
			}
		} catch (e) {}
	</script>

	<!-- Top Spacing Anchor -->
	<div class="h-8 opacity-0 pointer-events-none" aria-hidden="true"></div>

	<!-- Center Content: Animated Logo + Counter + Progress Bar -->
	<div class="flex flex-col items-center justify-center max-w-sm w-full gap-8 my-auto">
		<!-- Animated Geometric ACM Diamond Mark -->
		<div class="relative w-24 h-24 sm:w-28 sm:h-28 flex items-center justify-center">
			<svg
				class="w-full h-full animate-[spin_10s_linear_infinite]"
				viewBox="0 0 100 100"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
				role="img"
				aria-label="ACM Animated Mark"
			>
				<defs>
					<linearGradient id="preloaderGrad" x1="0%" y1="0%" x2="100%" y2="100%">
						<stop offset="0%" stop-color="#00F0FF" />
						<stop offset="100%" stop-color="#8B5CF6" />
					</linearGradient>
				</defs>
				<!-- Outer Rotating Diamond Frame -->
				<polygon
					points="50,6 94,50 50,94 6,50"
					stroke="url(#preloaderGrad)"
					stroke-width="2"
					stroke-dasharray="8 4"
					fill="#050B14"
				/>
				<!-- Inner Cyan Accent Rhombus -->
				<polygon
					points="50,20 80,50 50,80 20,50"
					stroke="#00F0FF"
					stroke-width="1.5"
					fill="url(#preloaderGrad)"
					fill-opacity="0.2"
				/>
				<!-- Center Node -->
				<circle cx="50" cy="50" r="4.5" fill="#00F0FF" />
			</svg>
			<!-- Ambient Glow -->
			<div
				class="absolute inset-0 bg-[#00F0FF]/15 blur-xl rounded-full -z-10 animate-pulse pointer-events-none"
				aria-hidden="true"
			></div>
		</div>

		<!-- Title Text -->
		<div class="text-center">
			<span class="text-xs uppercase tracking-[0.3em] font-semibold text-cream/70 block mb-1">
				ACM Tulas Student Chapter
			</span>
			<span class="text-[10px] uppercase tracking-[0.2em] text-[#00F0FF]/80 font-mono">
				Initializing Experience
			</span>
		</div>

		<!-- Progress Bar Container -->
		<div class="w-full max-w-[280px] sm:max-w-xs flex flex-col items-center gap-3">
			<div class="w-full h-1 sm:h-1.5 bg-[#050B14] rounded-full overflow-hidden border border-cyan/20 p-[1px]">
				<div
					id="preloader-progress-bar"
					class="h-full w-0 bg-gradient-to-r from-[#00F0FF] to-[#8B5CF6] rounded-full shadow-[0_0_12px_rgba(0,240,255,0.6)] transition-all duration-75 ease-out"
				></div>
			</div>

			<!-- Cyan Monospace Percentage -->
			<div
				id="preloader-counter"
				class="font-mono text-cyan text-lg sm:text-xl font-bold tracking-widest tabular-nums drop-shadow-[0_0_8px_rgba(0,240,255,0.5)]"
			>
				0%
			</div>
		</div>
	</div>

	<!-- Bottom-Centered ENTER SITE Button -->
	<div class="w-full flex justify-center pb-2">
		<button
			type="button"
			id="preloader-enter-btn"
			class="px-6 py-2.5 rounded-full border border-cyan/30 bg-[#050B14]/80 backdrop-blur-sm text-xs font-mono tracking-widest text-cream/80 hover:text-cyan hover:border-cyan hover:bg-cyan/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-[#020308] transition-all cursor-pointer shadow-[0_0_15px_rgba(0,240,255,0.1)] hover:shadow-[0_0_20px_rgba(0,240,255,0.3)]"
		>
			ENTER SITE <span class="text-cyan ml-1" aria-hidden="true">→</span>
		</button>
	</div>
</div>

<script>
	import { gsap } from 'gsap';

	function initPreloader() {
		const overlayElement = document.getElementById('preloader-overlay');
		if (!overlayElement) return;
		const overlay: HTMLElement = overlayElement;

		const progressBar = document.getElementById('preloader-progress-bar');
		const counter = document.getElementById('preloader-counter');
		const enterBtn = document.getElementById('preloader-enter-btn');

		// 1. Session gating & reduced motion check
		const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const alreadySeen = sessionStorage.getItem('intro-seen') === '1';

		if (alreadySeen || isReduced) {
			overlay.style.display = 'none';
			sessionStorage.setItem('intro-seen', '1');
			window.dispatchEvent(new CustomEvent('preloader:done'));
			return;
		}

		// 2. Lock page scrolling
		document.body.style.overflow = 'hidden';

		let targetProgress = 0;
		let displayedProgress = 0;
		let isCompleted = false;
		let animationFrameId: number | null = null;
		let hardCapTimeout: ReturnType<typeof setTimeout> | null = null;

		let fontSignal = 0;
		let videoSignal = 0;
		let windowSignal = 0;

		function updateTarget() {
			targetProgress = Math.min(100, fontSignal + videoSignal + windowSignal);
		}

		// Signal 1: document.fonts.ready = 40%
		if ('fonts' in document) {
			document.fonts.ready
				.then(() => {
					fontSignal = 40;
					updateTarget();
				})
				.catch(() => {
					fontSignal = 40;
					updateTarget();
				});
		} else {
			fontSignal = 40;
			updateTarget();
		}

		// Signal 2: hero video loadedmetadata = 40%
		const heroVideo = document.querySelector<HTMLVideoElement>('video');
		if (heroVideo) {
			if (heroVideo.readyState >= 1) {
				videoSignal = 40;
				updateTarget();
			} else {
				const onVideoReady = () => {
					videoSignal = 40;
					updateTarget();
				};
				heroVideo.addEventListener('loadedmetadata', onVideoReady, { once: true });
				heroVideo.addEventListener('error', onVideoReady, { once: true });
				setTimeout(onVideoReady, 1000);
			}
		} else {
			// Video not present or placeholder mode
			videoSignal = 40;
			updateTarget();
		}

		// Signal 3: window load = 20%
		if (document.readyState === 'complete') {
			windowSignal = 20;
			updateTarget();
		} else {
			window.addEventListener(
				'load',
				() => {
					windowSignal = 20;
					updateTarget();
				},
				{ once: true }
			);
		}

		// Eased ticker for progress calculation
		function tick() {
			if (isCompleted) return;

			const diff = targetProgress - displayedProgress;
			if (diff > 0.05) {
				displayedProgress += Math.max(0.4, diff * 0.12);
			}

			if (displayedProgress > 99.5 && targetProgress >= 100) {
				displayedProgress = 100;
				finishPreloader();
				return;
			}

			const rounded = Math.min(100, Math.floor(displayedProgress));
			if (progressBar) {
				progressBar.style.width = `${rounded}%`;
			}
			if (counter) {
				counter.textContent = `${rounded}%`;
			}

			animationFrameId = requestAnimationFrame(tick);
		}

		animationFrameId = requestAnimationFrame(tick);

		// 3. Completion routine
		function finishPreloader() {
			if (isCompleted) return;
			isCompleted = true;

			if (animationFrameId !== null) {
				cancelAnimationFrame(animationFrameId);
			}
			if (hardCapTimeout !== null) {
				clearTimeout(hardCapTimeout);
			}

			if (progressBar) {
				progressBar.style.width = '100%';
			}
			if (counter) {
				counter.textContent = '100%';
			}

			gsap.to(overlay, {
				yPercent: -100,
				duration: 0.7,
				ease: 'power4.inOut',
				onComplete: () => {
					overlay.style.display = 'none';
					document.body.style.overflow = '';
					sessionStorage.setItem('intro-seen', '1');
					window.dispatchEvent(new CustomEvent('preloader:done'));
				},
			});
		}

		// 4. ENTER SITE button immediate skip
		enterBtn?.addEventListener('click', () => {
			targetProgress = 100;
			displayedProgress = 100;
			finishPreloader();
		});

		// Hard cap at 2500ms
		hardCapTimeout = setTimeout(() => {
			if (!isCompleted) {
				targetProgress = 100;
				fontSignal = 40;
				videoSignal = 40;
				windowSignal = 20;
			}
		}, 2500);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initPreloader);
	} else {
		initPreloader();
	}
</script>
