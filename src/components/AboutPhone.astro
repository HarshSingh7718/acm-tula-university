---
---

<section
	id="about-phone"
	aria-labelledby="about-phone-heading"
	class="relative w-full bg-[#020308] select-none py-16 sm:py-24 px-4 sm:px-8 overflow-hidden scroll-mt-20 flex flex-col items-center justify-center"
>
	<!-- Ambient Background Glow -->
	<div
		class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-gradient-to-tr from-cyan/10 to-violet/10 rounded-full blur-3xl pointer-events-none -z-0"
		aria-hidden="true"
	></div>

	<!-- Section Header -->
	<div class="max-w-4xl mx-auto text-center mb-12 sm:mb-16 relative z-10">
		<div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#050B14] border border-cyan/30 text-[11px] font-mono tracking-widest text-cyan uppercase mb-3">
			<span class="w-1.5 h-1.5 rounded-full bg-cyan shadow-[0_0_8px_#00F0FF] animate-pulse"></span>
			<span>MOBILE ECOSYSTEM</span>
		</div>
		<h2
			id="about-phone-heading"
			class="text-3xl sm:text-5xl font-wide font-black uppercase tracking-tight text-cream"
		>
			CHAPTER AT YOUR FINGERTIPS
		</h2>
		<p class="text-xs sm:text-sm text-cream/70 font-mono mt-3 max-w-xl mx-auto">
			Instant notifications, hackathon squad matchmaking, workshop check-ins, and peer code reviews.
		</p>
	</div>

	<!-- SMARTPHONE FRAME MOCKUP (RESPONSIVE, ACCESSIBLE, ZERO JS) -->
	<div class="relative z-10 w-[290px] sm:w-[320px] md:w-[340px] aspect-[9/19] rounded-[48px] bg-[#0b101c] border-[7px] border-[#1a233a] shadow-[0_0_50px_rgba(0,240,255,0.15),0_25px_60px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col p-3 transition-transform duration-300 hover:scale-[1.02]">
		<!-- Dynamic Island / Speaker Pill -->
		<div class="w-full flex justify-center pt-1 pb-2">
			<div class="w-24 h-5 rounded-full bg-[#020308] border border-cyan/20 flex items-center justify-between px-2.5">
				<div class="w-2 h-2 rounded-full bg-cyan/40"></div>
				<div class="w-2.5 h-2.5 rounded-full bg-cyan/80 animate-pulse"></div>
			</div>
		</div>

		<!-- INNER PHONE SCREEN -->
		<div class="w-full h-full rounded-[36px] bg-[#050B14] border border-cyan/15 overflow-hidden flex flex-col justify-between p-4 relative">
			<!-- Header inside Screen -->
			<div class="flex items-center justify-between pb-3 border-b border-cyan/15">
				<div class="flex items-center gap-1.5">
					<span class="w-2 h-2 rounded-full bg-cyan"></span>
					<span class="text-[10px] font-mono font-bold text-cyan">ACM HUB</span>
				</div>
				<span class="text-[9px] font-mono text-cream/50">LIVE // V2.0</span>
			</div>

			<!-- Feed Cards Mockup -->
			<div class="flex flex-col gap-2.5 my-auto">
				<!-- Notification Card 1 -->
				<div class="p-2.5 rounded-xl bg-[#020308]/90 border border-cyan/20 flex items-center gap-2.5 shadow-sm">
					<div class="w-7 h-7 rounded-lg bg-cyan/15 border border-cyan/30 flex items-center justify-center text-cyan text-[10px] font-mono font-bold shrink-0">
						&gt;_
					</div>
					<div class="overflow-hidden">
						<div class="text-[11px] font-bold text-cream truncate">CodeGenesis 2025</div>
						<div class="text-[9px] font-mono text-cyan truncate">Registration is now live</div>
					</div>
				</div>

				<!-- Notification Card 2 -->
				<div class="p-2.5 rounded-xl bg-[#020308]/90 border border-violet/20 flex items-center gap-2.5 shadow-sm">
					<div class="w-7 h-7 rounded-lg bg-violet/15 border border-violet/30 flex items-center justify-center text-violet text-[10px] font-mono font-bold shrink-0">
						AI
					</div>
					<div class="overflow-hidden">
						<div class="text-[11px] font-bold text-cream truncate">AI Summit Keynote</div>
						<div class="text-[9px] font-mono text-violet truncate">Seats filling quickly</div>
					</div>
				</div>

				<!-- Notification Card 3 -->
				<div class="p-2.5 rounded-xl bg-[#020308]/90 border border-cyan/20 flex items-center gap-2.5 shadow-sm">
					<div class="w-7 h-7 rounded-lg bg-cyan/15 border border-cyan/30 flex items-center justify-center text-cyan text-[10px] font-mono font-bold shrink-0">
						CTF
					</div>
					<div class="overflow-hidden">
						<div class="text-[11px] font-bold text-cream truncate">CyberShield Qualifier</div>
						<div class="text-[9px] font-mono text-cream/60 truncate">Team invites open</div>
					</div>
				</div>
			</div>

			<!-- Bottom Home Indicator Pill -->
			<div class="w-full flex justify-center pt-2">
				<div class="w-28 h-1 rounded-full bg-cream/30"></div>
			</div>
		</div>
	</div>
</section>
