---
---

<section
	id="contact"
	aria-labelledby="contact-heading"
	class="relative w-full bg-[#020308] select-none scroll-mt-20"
>
	<!-- ========================================== -->
	<!-- 1. MOBILE CONTACT VIEW (BLOCK ON MOBILE, HIDDEN ON MD+) -->
	<!-- ========================================== -->
	<div class="block md:hidden w-full px-4 py-16">
		<div
			class="mx-auto max-w-xl rounded-[32px] border border-white/15 bg-white/[0.04] p-6 text-white shadow-[0_15px_45px_rgba(0,0,0,0.45)] backdrop-blur-xl"
		>
			<div class="mb-6 text-center">
				<span class="text-cyan font-mono text-[10px] tracking-[0.3em] uppercase font-bold block mb-1">
					INITIALIZE PROTOCOL
				</span>
				<h3 class="text-3xl font-wide font-black uppercase text-cream tracking-tight">
					Contact us!
				</h3>
				<p class="mt-1 text-xs font-mono uppercase tracking-[0.35em] text-cream/60">
					Say Hello!
				</p>
			</div>

			<form
				class="flex flex-col gap-4 text-sm"
				method="POST"
				id="contact-form-mobile"
			>
				<div class="flex flex-col gap-4 sm:flex-row sm:gap-3">
					<label
						class="flex flex-col gap-1.5 text-xs font-mono font-semibold uppercase tracking-[0.25em] text-cream/70"
					>
						First Name *
						<input
							type="text"
							name="firstName"
							required
							class="rounded-2xl border-2 border-dashed border-white/30 bg-transparent px-4 py-3 text-sm font-mono text-white outline-none transition focus:border-cyan"
						/>
					</label>
					<label
						class="flex flex-col gap-1.5 text-xs font-mono font-semibold uppercase tracking-[0.25em] text-cream/70"
					>
						Last Name
						<input
							type="text"
							name="lastName"
							class="rounded-2xl border-2 border-dashed border-white/30 bg-transparent px-4 py-3 text-sm font-mono text-white outline-none transition focus:border-cyan"
						/>
					</label>
				</div>

				<label
					class="flex flex-col gap-1.5 text-xs font-mono font-semibold uppercase tracking-[0.25em] text-cream/70"
				>
					Email *
					<input
						type="email"
						name="email"
						required
						class="rounded-2xl border-2 border-dashed border-white/30 bg-transparent px-4 py-3 text-sm font-mono text-white outline-none transition focus:border-cyan"
					/>
				</label>

				<label
					class="flex flex-col gap-1.5 text-xs font-mono font-semibold uppercase tracking-[0.25em] text-cream/70"
				>
					Phone
					<input
						type="tel"
						name="phone"
						inputmode="tel"
						pattern="^[0-9+()\\s-]{7,}$"
						class="rounded-2xl border-2 border-dashed border-white/30 bg-transparent px-4 py-3 text-sm font-mono text-white outline-none transition focus:border-cyan"
					/>
				</label>

				<label
					class="flex flex-col gap-1.5 text-xs font-mono font-semibold uppercase tracking-[0.25em] text-cream/70"
				>
					Message *
					<textarea
						name="message"
						rows="4"
						required
						class="rounded-2xl border-2 border-dashed border-white/30 bg-transparent px-4 py-3 text-sm font-mono text-white outline-none transition focus:border-cyan resize-none"
					></textarea>
				</label>

				<button
					type="submit"
					class="mt-2 inline-flex items-center justify-center rounded-full border border-cyan/60 bg-cyan/15 px-8 py-3 text-sm font-mono font-bold uppercase tracking-[0.3em] text-cyan hover:bg-cyan hover:text-black transition-all shadow-[0_0_20px_rgba(0,240,255,0.25)] hover:shadow-[0_0_30px_rgba(0,240,255,0.5)] cursor-pointer"
				>
					Submit Dispatch →
				</button>

				<div class="pt-3 border-t border-white/10 flex flex-col items-center">
					<button
						type="button"
						id="show-community-btn-mobile"
						class="w-full inline-flex items-center justify-center gap-2 rounded-full border border-[#25D366]/50 bg-[#25D366]/10 px-6 py-2.5 text-xs font-mono font-bold uppercase tracking-widest text-[#25D366] hover:bg-[#25D366] hover:text-black transition-all cursor-pointer shadow-[0_0_15px_rgba(37,211,102,0.2)]"
					>
						<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.066-1.127-.074-.27-.087-.62-.208-1.077-.406-1.927-.837-3.18-2.772-3.277-2.902-.097-.129-.779-1.036-.779-1.975 0-.939.492-1.4.667-1.595.176-.195.385-.244.513-.244.129 0 .257.002.368.007.118.005.275-.045.431.328.163.387.555 1.353.604 1.452.049.099.082.215.016.345-.065.131-.098.213-.195.328-.098.115-.207.257-.295.345-.098.098-.201.205-.086.402.115.197.511.843 1.096 1.364.753.671 1.388.878 1.585.976.197.098.312.082.427-.049.115-.131.492-.573.623-.77.131-.197.262-.164.443-.098.18.066 1.147.541 1.344.639.197.098.328.148.377.23.049.082.049.476-.095.881z"/></svg>
						Show Community Channel
					</button>
				</div>
			</form>
		</div>
	</div>

	<!-- ========================================== -->
	<!-- 2. DESKTOP 3D LAPTOP CANVAS STAGE (HIDDEN ON MOBILE, MD:BLOCK WITH 300VH SCRUB) -->
	<!-- ========================================== -->
	<div class="laptop-section hidden md:block relative w-full h-[300vh]">
		<div
			class="sticky top-0 left-0 w-full h-screen flex items-center justify-center overflow-hidden"
		>
			<canvas
				id="laptop-canvas"
				class="w-[96vw] max-w-[1350px] h-[86vh] max-h-[850px] object-contain brightness-110"
			></canvas>
			<div
				class="contact-heading absolute top-[20%] left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-center z-10 opacity-100 pointer-events-none"
			>
				<div
					id="contact-heading"
					class="justify-start text-white text-5xl sm:text-6xl font-semibold font-wide uppercase tracking-tight"
				>
					Contact us!
				</div>
			</div>

			<!-- Contact Form Overlay -->
			<div
				class="contact-form-overlay absolute top-[6%] left-[12.5%] w-[75%] h-[76%] z-20 opacity-0 pointer-events-none flex flex-col items-center justify-center translate-x-2 sm:translate-x-3"
			>
				<div class="flex flex-col items-center text-black mb-1">
					<div
						class="text-center justify-start text-stone-900 text-2xl sm:text-3xl font-bold font-wide tracking-tight"
					>
						Say Hello!
					</div>
				</div>

				<form
					class="contact-form pointer-events-auto mt-2 flex w-full max-w-[54%] flex-col gap-3 text-xs text-black px-4"
					method="POST"
					id="contact-form-desktop"
				>
					<div class="contact-grid grid gap-3 sm:grid-cols-2">
						<label
							class="flex flex-col gap-1.5 text-[8px] font-semibold uppercase tracking-[0.35em] text-neutral-500 sm:text-[10px]"
						>
							First Name
							<input
								type="text"
								name="firstName"
								required
								class="contact-input"
							/>
						</label>
						<label
							class="flex flex-col gap-1.5 text-[8px] font-semibold uppercase tracking-[0.35em] text-neutral-500 sm:text-[10px]"
						>
							Last Name
							<input type="text" name="lastName" class="contact-input" />
						</label>
					</div>

					<div class="contact-grid grid gap-3 sm:grid-cols-2">
						<label
							class="flex flex-col gap-1.5 text-[8px] font-semibold uppercase tracking-[0.35em] text-neutral-500 sm:text-[10px]"
						>
							Email
							<input type="email" name="email" required class="contact-input" />
						</label>
						<label
							class="flex flex-col gap-1.5 text-[8px] font-semibold uppercase tracking-[0.35em] text-neutral-500 sm:text-[10px]"
						>
							Phone
							<input
								type="tel"
								name="phone"
								inputmode="tel"
								pattern="^[0-9+()\\s-]{7,}$"
								class="contact-input"
							/>
						</label>
					</div>

					<label
						class="flex flex-col gap-1.5 text-[8px] font-semibold uppercase tracking-[0.35em] text-neutral-500 sm:text-[10px]"
					>
						Message
						<textarea
							name="message"
							rows="2"
							required
							class="contact-input resize-none py-2"
						></textarea>
					</label>

					<div class="flex items-center justify-center gap-3 mt-2">
						<div
							class="w-36 h-9 bg-stone-900 rounded-[200px] flex items-center justify-center overflow-hidden"
						>
							<button
								type="submit"
								class="group inline-flex items-center justify-center gap-2 w-full h-full text-base font-light text-[#ffeead] sm:text-lg hover:bg-white/5 transition-colors cursor-pointer"
							>
								Submit
							</button>
						</div>

						<button
							type="button"
							id="show-community-btn-desktop"
							class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-full border border-[#25D366]/70 bg-[#25D366]/15 hover:bg-[#25D366] hover:text-black text-[10px] sm:text-[11px] font-mono font-bold tracking-wider text-black transition-all cursor-pointer shadow-[0_0_15px_rgba(37,211,102,0.25)]"
						>
							<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.066-1.127-.074-.27-.087-.62-.208-1.077-.406-1.927-.837-3.18-2.772-3.277-2.902-.097-.129-.779-1.036-.779-1.975 0-.939.492-1.4.667-1.595.176-.195.385-.244.513-.244.129 0 .257.002.368.007.118.005.275-.045.431.328.163.387.555 1.353.604 1.452.049.099.082.215.016.345-.065.131-.098.213-.195.328-.098.115-.207.257-.295.345-.098.098-.201.205-.086.402.115.197.511.843 1.096 1.364.753.671 1.388.878 1.585.976.197.098.312.082.427-.049.115-.131.492-.573.623-.77.131-.197.262-.164.443-.098.18.066 1.147.541 1.344.639.197.098.328.148.377.23.049.082.049.476-.095.881z"/></svg>
							Community Channel
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- ========================================== -->
	<!-- 3. COMMUNITY CHANNEL QR POPUP MODAL -->
	<!-- ========================================== -->
	<div
		id="communityModal"
		class="fixed inset-0 z-[100] flex items-center justify-center bg-black/85 backdrop-blur-xl opacity-0 pointer-events-none transition-all duration-300 p-4"
		role="dialog"
		aria-modal="true"
		aria-labelledby="community-modal-title"
	>
		<!-- Backdrop Glow -->
		<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-[#25D366]/15 via-black/60 to-black pointer-events-none"></div>

		<!-- Modal Card -->
		<div
			class="community-modal-card relative w-full max-w-sm sm:max-w-md mx-auto rounded-[32px] border border-[#25D366]/40 bg-[#060a12]/95 p-6 sm:p-8 text-center text-white shadow-[0_0_60px_rgba(37,211,102,0.25)] flex flex-col items-center justify-center transform scale-95 transition-transform duration-300"
		>
			<!-- Close Button (Top Right) -->
			<button
				type="button"
				id="closeCommunityModalBtn"
				class="absolute top-4 right-4 w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 flex items-center justify-center text-white transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#25D366]"
				aria-label="Close dialog"
			>
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>

			<!-- Badge -->
			<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#25D366]/15 border border-[#25D366]/40 text-[#25D366] text-[10px] font-mono font-bold tracking-widest uppercase mb-2.5">
				<span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span>
				OFFICIAL COMMUNITY
			</div>

			<!-- Heading -->
			<h3 id="community-modal-title" class="text-xl sm:text-2xl font-bold font-wide text-white tracking-tight uppercase">
				Tulas ACM Members
			</h3>
			<p class="mt-1 text-xs font-mono text-cream/70 max-w-xs leading-relaxed">
				Official WhatsApp Community Channel
			</p>

			<!-- QR Code Card -->
			<div class="mt-4 p-2.5 rounded-2xl bg-white shadow-[0_12px_35px_rgba(0,0,0,0.6)] border border-white/30 flex items-center justify-center max-w-[240px] sm:max-w-[260px] w-full overflow-hidden">
				<img
					src="/media/images/whatsapp_qr.png"
					alt="TULAS ACM MEMBERS WhatsApp Group QR Code"
					class="w-full h-auto object-contain rounded-xl select-none"
					loading="eager"
				/>
			</div>

			<p class="mt-2.5 text-[11px] font-mono text-cream/60">
				Scan with WhatsApp Camera OR click below to join:
			</p>

			<!-- Join Redirect Button -->
			<div class="mt-4 flex flex-col sm:flex-row items-center gap-3 w-full">
				<a
					href="https://chat.whatsapp.com/LOMvSlh1AbY6QZ59NMgVKG?s=qt&p=a&mlu=4"
					target="_blank"
					rel="noopener noreferrer"
					id="join-whatsapp-direct-btn"
					class="w-full py-3 rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-black text-sm font-mono font-extrabold uppercase tracking-widest transition-all duration-200 shadow-[0_0_25px_rgba(37,211,102,0.4)] hover:shadow-[0_0_35px_rgba(37,211,102,0.6)] flex items-center justify-center gap-2 cursor-pointer"
				>
					<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.316 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.818-.981z"/></svg>
					Join WhatsApp Group →
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.contact-input {
		border-radius: 0.75rem;
		border: 1.5px dashed #050505;
		background: transparent;
		padding: 0.6rem 0.8rem;
		font-size: 0.8rem;
		font-weight: 500;
		color: #050505;
		outline: none;
		transition: border 0.2s ease;
		width: 100%;
	}

	.contact-input:focus {
		border-color: #00F0FF;
	}

	/* Adjust form layout for the laptop screen size */
	.contact-form {
		height: auto;
	}
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	// 1. Mobile Form Handler
	const mobileForm = document.getElementById('contact-form-mobile') as HTMLFormElement | null;
	if (mobileForm) {
		mobileForm.addEventListener('submit', (e) => {
			e.preventDefault();
			const formData = new FormData(mobileForm);
			const firstName = (formData.get('firstName') as string) || '';
			const lastName = (formData.get('lastName') as string) || '';
			const senderEmail = (formData.get('email') as string) || '';
			const phone = (formData.get('phone') as string) || '';
			const message = (formData.get('message') as string) || '';

			const subject = encodeURIComponent(`Inquiry from ${firstName} ${lastName} - ACM Tulas`);
			const body = encodeURIComponent(
				`Hello ACM Tulas Team,\n\n` +
				`Name: ${firstName} ${lastName}\n` +
				`Email: ${senderEmail}\n` +
				`Phone: ${phone}\n\n` +
				`Message:\n${message}\n\n` +
				`---\nSent from ACM Tulas Website`
			);

			const mailtoUrl = `mailto:acmtulas@gmail.com?subject=${subject}&body=${body}`;
			window.location.href = mailtoUrl;
			mobileForm.reset();
		});
	}

	// 2. Desktop Canvas Scrub Sequence
	function initLaptopCanvas() {
		const canvas = document.querySelector<HTMLCanvasElement>('#laptop-canvas');
		const section = document.querySelector<HTMLElement>('.laptop-section');
		if (!canvas || !section || section.dataset.canvasInit === 'true') return;
		section.dataset.canvasInit = 'true';

		const context = canvas.getContext('2d', { alpha: true });
		if (!context) return;

		const frameCount = 125;
		const narrowQuery = '(max-width: 1024px)';
		let maxCacheSize = frameCount;
		let preloadRadius = 8;
		const pendingFrames = new Set<number>();
		const frameCache = new Map<number, HTMLImageElement>();
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const laptop = {
			frame: 0,
		};

		const updatePerfSettings = () => {
			const isNarrow = window.matchMedia(narrowQuery).matches;
			maxCacheSize = isNarrow ? Math.min(16, frameCount) : frameCount;
			preloadRadius = isNarrow ? 4 : 8;
		};

		const currentFrame = (index: number) =>
			`/media/laptopFrames/frame_${(index + 1).toString().padStart(4, '0')}.avif`;

		const clampFrame = (index: number) =>
			Math.max(0, Math.min(frameCount - 1, Math.round(index)));

		const resizeCanvas = () => {
			updatePerfSettings();
			const rect = canvas.getBoundingClientRect();
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			const width = Math.max(300, Math.round((rect.width || window.innerWidth * 0.95) * dpr));
			const height = Math.max(200, Math.round((rect.height || window.innerHeight * 0.85) * dpr));
			if (canvas.width !== width || canvas.height !== height) {
				canvas.width = width;
				canvas.height = height;
			}
		};

		const drawToCanvas = (img: HTMLImageElement) => {
			if (!canvas || !context || !img || !img.naturalWidth) return;
			if (canvas.width === 0 || canvas.height === 0) {
				resizeCanvas();
			}
			context.clearRect(0, 0, canvas.width, canvas.height);
			const hRatio = canvas.width / img.naturalWidth;
			const vRatio = canvas.height / img.naturalHeight;
			const ratio = Math.min(hRatio, vRatio);
			const centerShift_x = (canvas.width - img.naturalWidth * ratio) / 2;
			const centerShift_y = (canvas.height - img.naturalHeight * ratio) / 2;
			context.drawImage(
				img,
				0,
				0,
				img.naturalWidth,
				img.naturalHeight,
				centerShift_x,
				centerShift_y,
				img.naturalWidth * ratio,
				img.naturalHeight * ratio
			);
		};

		const trimCache = (center: number) => {
			if (maxCacheSize >= frameCount || frameCache.size <= maxCacheSize) return;
			const keys = Array.from(frameCache.keys()).sort(
				(a, b) => Math.abs(a - center) - Math.abs(b - center)
			);
			const keep = new Set(keys.slice(0, maxCacheSize));
			for (const key of frameCache.keys()) {
				if (!keep.has(key)) frameCache.delete(key);
			}
		};

		const loadFrame = (index: number): Promise<HTMLImageElement | null> => {
			const clampedIndex = clampFrame(index);
			const cached = frameCache.get(clampedIndex);
			if (cached && cached.naturalWidth > 0) return Promise.resolve(cached);

			if (pendingFrames.has(clampedIndex)) return Promise.resolve(null);
			pendingFrames.add(clampedIndex);

			return new Promise((resolve) => {
				const img = new Image();
				img.src = currentFrame(clampedIndex);
				img.onload = () => {
					pendingFrames.delete(clampedIndex);
					frameCache.set(clampedIndex, img);
					trimCache(clampedIndex);
					resolve(img);
				};
				img.onerror = () => {
					pendingFrames.delete(clampedIndex);
					resolve(null);
				};
			});
		};

		const queueFrames = (center: number) => {
			const start = Math.max(0, center - preloadRadius);
			const end = Math.min(frameCount - 1, center + preloadRadius);
			for (let i = start; i <= end; i++) {
				void loadFrame(i);
			}
		};

		const preloadAllFrames = async () => {
			const concurrency = Math.min(6, frameCount);
			let nextIndex = 0;
			const worker = async () => {
				while (nextIndex < frameCount) {
					const idx = nextIndex++;
					await loadFrame(idx);
				}
			};
			await Promise.all(Array.from({ length: concurrency }, () => worker()));
		};

		const render = () => {
			const frame = clampFrame(laptop.frame);
			const img = frameCache.get(frame);
			if (!img || !img.naturalWidth) {
				void loadFrame(frame).then((loaded) => {
					if (loaded && frame === clampFrame(laptop.frame)) {
						drawToCanvas(loaded);
					}
				});
				return;
			}
			drawToCanvas(img);
			queueFrames(frame);
		};

		// Initialize sequence
		resizeCanvas();
		loadFrame(0).then((firstImg) => {
			if (firstImg) {
				drawToCanvas(firstImg);
			}
			preloadAllFrames();
		});

		if (prefersReducedMotion) {
			const formOverlay = document.querySelector<HTMLElement>('.contact-form-overlay');
			if (formOverlay) {
				formOverlay.style.opacity = '1';
				formOverlay.style.pointerEvents = 'auto';
			}
			const heading = document.querySelector<HTMLElement>('.contact-heading');
			if (heading) {
				heading.style.opacity = '0';
				heading.style.transform = 'translateY(-50px)';
			}
			loadFrame(frameCount - 1).then((lastImg) => {
				if (lastImg) drawToCanvas(lastImg);
			});
			return;
		}

		// GSAP ScrollTrigger Sequence
		const tl = gsap.timeline({
			scrollTrigger: {
				trigger: section,
				start: 'top top',
				end: 'bottom bottom',
				scrub: 0.5,
			},
		});

		tl.to(laptop, {
			frame: frameCount - 1,
			snap: 'frame',
			ease: 'none',
			duration: 2,
			onUpdate: render,
		})
			.to(
				'.contact-heading',
				{
					opacity: 0,
					y: -50,
					duration: (20 / frameCount) * 2,
					ease: 'none',
				},
				`<+${(40 / frameCount) * 2}`
			)
			.to(
				'.contact-form-overlay',
				{
					opacity: 1,
					pointerEvents: 'auto',
					duration: 0.5,
					ease: 'power2.inOut',
				},
				`<+${(40 / frameCount) * 2}`
			);

		window.addEventListener('resize', () => {
			resizeCanvas();
			render();
		});
	}

	// Setup WhatsApp Community Modal
	function setupCommunityModal() {
		const modal = document.getElementById('communityModal');
		const card = modal?.querySelector('.community-modal-card');
		const closeBtn = document.getElementById('closeCommunityModalBtn');

		if (!modal) return;

		const openModal = (e?: Event) => {
			if (e) {
				e.preventDefault();
				e.stopPropagation();
			}
			modal.classList.remove('opacity-0', 'pointer-events-none');
			modal.classList.add('opacity-100');
			if (card) {
				card.classList.remove('scale-95');
				card.classList.add('scale-100');
			}
		};

		const closeModal = () => {
			modal.classList.add('opacity-0', 'pointer-events-none');
			modal.classList.remove('opacity-100');
			if (card) {
				card.classList.add('scale-95');
				card.classList.remove('scale-100');
			}
		};

		const triggers = document.querySelectorAll(
			'.trigger-community-modal, #show-community-btn-mobile, #show-community-btn-desktop, #show-community-btn-footer'
		);
		triggers.forEach((btn) => {
			btn.removeEventListener('click', openModal);
			btn.addEventListener('click', openModal);
		});

		closeBtn?.addEventListener('click', closeModal);

		modal.addEventListener('click', (e) => {
			if (e.target === modal) {
				closeModal();
			}
		});

		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !modal.classList.contains('opacity-0')) {
				closeModal();
			}
		});
	}

	function initAll() {
		setupCommunityModal();
		initLaptopCanvas();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initAll);
	} else {
		initAll();
	}
	window.addEventListener('load', initAll);
	document.addEventListener('astro:page-load', initAll);

	// Desktop Form Handling
	const desktopForm = document.getElementById('contact-form-desktop') as HTMLFormElement | null;
	if (desktopForm) {
		desktopForm.addEventListener('submit', (e) => {
			e.preventDefault();
			const formData = new FormData(desktopForm);
			const firstName = (formData.get('firstName') as string) || '';
			const lastName = (formData.get('lastName') as string) || '';
			const senderEmail = (formData.get('email') as string) || '';
			const phone = (formData.get('phone') as string) || '';
			const message = (formData.get('message') as string) || '';

			const subject = encodeURIComponent(`Inquiry from ${firstName} ${lastName} - ACM Tulas`);
			const body = encodeURIComponent(
				`Hello ACM Tulas Team,\n\n` +
				`Name: ${firstName} ${lastName}\n` +
				`Email: ${senderEmail}\n` +
				`Phone: ${phone}\n\n` +
				`Message:\n${message}\n\n` +
				`---\nSent from ACM Tulas Website`
			);

			const mailtoUrl = `mailto:acmtulas@gmail.com?subject=${subject}&body=${body}`;
			window.location.href = mailtoUrl;

			desktopForm.reset();
		});
	}
</script>
