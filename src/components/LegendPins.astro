---
---

<div
	id="legend-pins-container"
	class="hidden md:flex fixed bottom-8 inset-x-0 z-30 pointer-events-none justify-between items-end px-8 lg:px-12 text-xs font-mono tracking-wider select-none opacity-0"
	aria-hidden="true"
>
	<!-- Bottom-Left Pin -->
	<div class="flex items-center gap-2.5 bg-[#050B14]/75 backdrop-blur-md border border-cyan/20 px-4 py-2 rounded-full shadow-[0_0_20px_rgba(0,0,0,0.6)]">
		<span class="w-1.5 h-1.5 rounded-full bg-cyan shadow-[0_0_8px_#00F0FF] animate-pulse"></span>
		<span class="text-cream/90">
			Established in <span class="text-cyan font-bold">2025</span>. Engineering the future.
		</span>
	</div>

	<!-- Bottom-Right Pin -->
	<div class="flex items-center gap-2.5 bg-[#050B14]/75 backdrop-blur-md border border-cyan/20 px-4 py-2 rounded-full shadow-[0_0_20px_rgba(0,0,0,0.6)]">
		<span class="text-cream/90">
			<span class="text-cyan font-semibold">Driven by curiosity.</span> United by technology.
		</span>
		<span class="w-1.5 h-1.5 rounded-full bg-violet shadow-[0_0_8px_#8B5CF6]"></span>
	</div>
</div>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { isReducedMotion } from '../scripts/scroll';

	gsap.registerPlugin(ScrollTrigger);

	function setupLegendPins() {
		const containerElement = document.getElementById('legend-pins-container');
		if (!containerElement) return;
		const container: HTMLElement = containerElement;

		// Initial fade in after hero entrance or if already seen
		function showPins() {
			if (isReducedMotion()) {
				container.style.opacity = '1';
				return;
			}
			gsap.to(container, {
				opacity: 1,
				duration: 0.8,
				ease: 'power2.out',
				delay: 0.3,
			});
		}

		if (sessionStorage.getItem('intro-seen') === '1') {
			showPins();
		} else {
			window.addEventListener('preloader:done', showPins, { once: true });
			setTimeout(showPins, 2800);
		}

		// Single ScrollTrigger controlling fade in/out as user scrolls through the hero section
		const trigger = ScrollTrigger.create({
			trigger: '#home',
			start: 'top top',
			end: 'bottom 40%',
			onUpdate: (self) => {
				if (isReducedMotion()) return;
				const alpha = Math.max(0, 1 - self.progress * 1.6);
				gsap.to(container, {
					opacity: alpha,
					y: self.progress * 25,
					duration: 0.1,
					overwrite: 'auto',
				});
			},
		});

		window.addEventListener(
			'pagehide',
			() => {
				trigger.kill();
			},
			{ once: true }
		);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupLegendPins);
	} else {
		setupLegendPins();
	}
	document.addEventListener('astro:page-load', setupLegendPins);
</script>
