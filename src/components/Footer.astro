---
const navLinks = [
	{ label: 'ABOUT', href: '#about' },
	{ label: 'EVENTS', href: '#events' },
	{ label: 'TEAM', href: '#board' },
	{ label: 'GALLERY', href: '#gallery' },
	{ label: 'CONTACT', href: '#contact' },
];

const currentYear = new Date().getFullYear();
---

<footer
	id="footer"
	aria-labelledby="footer-heading"
	class="relative border-t border-cyan/20 py-16 px-6 sm:px-12 bg-[#020308] text-cream select-none z-10"
>
	<div class="max-w-7xl mx-auto flex flex-col gap-12">
		<!-- Top Row: Branding, Navigation Links & Back to Top -->
		<div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8 pb-10 border-b border-cyan/15">
			<!-- Brand Info -->
			<div class="flex flex-col gap-2">
				<div class="flex items-center gap-2">
					<img
						src="/media/images/acm_tulas_logo.svg"
						alt="ACM Tulas Student Chapter"
						class="h-10 sm:h-12 w-auto max-w-[200px] object-contain block select-none"
						width="180"
						height="48"
						loading="lazy"
						decoding="async"
					/>
				</div>
				<p class="text-xs text-cream/60 font-mono max-w-sm mt-1">
					Tulas University, Dhoolkot, PO-Selaqui, Chakrata Road, Dehradun, Uttarakhand, India 248011.
				</p>
			</div>

			<!-- Navigation Links & Social Media Icons -->
			<div class="flex flex-wrap items-center gap-6 sm:gap-8">
				<nav aria-label="Footer Navigation" class="flex flex-wrap items-center gap-6">
					{
						navLinks.map((link) => (
							<a
								href={link.href}
								class="text-xs font-mono tracking-widest text-cream/70 hover:text-cyan transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-cyan rounded py-1"
							>
								{link.label}
							</a>
						))
					}
				</nav>

				<!-- Subtle Divider -->
				<div class="hidden sm:block w-[1px] h-4 bg-cyan/20" aria-hidden="true"></div>

				<!-- Social Media Links -->
				<div class="flex items-center gap-3">
					<a
						href="https://www.instagram.com/acmtulas/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="ACM Tulas Instagram"
						class="w-8 h-8 rounded-full bg-[#050B14] border border-cyan/30 text-cream/70 hover:text-cyan hover:border-cyan hover:bg-cyan/10 hover:shadow-[0_0_12px_rgba(0,240,255,0.35)] flex items-center justify-center transition-all duration-200 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-cyan"
					>
						<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
						</svg>
					</a>
					<a
						href="https://www.linkedin.com/company/tulasacm/posts/?feedView=all"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="ACM Tulas LinkedIn"
						class="w-8 h-8 rounded-full bg-[#050B14] border border-cyan/30 text-cream/70 hover:text-cyan hover:border-cyan hover:bg-cyan/10 hover:shadow-[0_0_12px_rgba(0,240,255,0.35)] flex items-center justify-center transition-all duration-200 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-cyan"
					>
						<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
						</svg>
					</a>
				</div>
			</div>

			<!-- Back to Top Button -->
			<div>
				<a
					href="#home"
					class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#050B14] border border-cyan/30 text-cyan text-xs font-mono hover:bg-cyan/10 hover:border-cyan transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan shadow-[0_0_15px_rgba(0,240,255,0.1)]"
					aria-label="Back to top of page"
				>
					<span>TOP</span>
					<span aria-hidden="true">↑</span>
				</a>
			</div>
		</div>

		<!-- Bottom Row: Copyright & Legal Notice -->
		<div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left text-xs font-mono text-cream/50">
			<div class="flex items-center gap-2">
				<img
					src="/media/images/acm_tulas_mark.svg"
					alt="ACM Mark"
					class="w-4 h-4 object-contain opacity-75"
					width="16"
					height="16"
					loading="lazy"
					decoding="async"
				/>
				<p class="m-0">
					© {currentYear} ACM Student Chapter · Tulas University. All rights reserved.
				</p>
			</div>
			<p class="m-0 flex items-center gap-2">
				<span class="w-1.5 h-1.5 rounded-full bg-cyan shadow-[0_0_6px_#00F0FF] animate-pulse"></span>
				<span>AFFILIATED CHARTER OF ACM INTERNATIONAL</span>
			</p>
		</div>
	</div>
</footer>
